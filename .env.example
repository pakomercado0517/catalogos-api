DATABASE_PUBLIC_URL=postgres://user:password@host:5432/catalogos
SCRAPING_API_KEY=genera-un-secreto-largo-y-unico
NODE_ENV=production

# Opcional: limites de scraping (valores por defecto entre parentesis)
# SCRAPING_COMPANY_COOLDOWN_MS=900000
# SCRAPING_IP_MAX_REQUESTS=5
# SCRAPING_IP_WINDOW_MS=3600000

# Opcional: cron automatico (desactivado por defecto)
# SCRAPING_CRON_ENABLED=true
# SCRAPING_CRON_SCHEDULE=0 6 * * 0
# SCRAPING_CRON_COMPANY_IDS=1,2,3,4

# Opcional: cache y timeouts
# READ_CACHE_TTL_MS=300000
# SCRAPING_PAGE_TIMEOUT_MS=30000
# SCRAPING_NAVIGATION_TIMEOUT_MS=45000

# Payload HTTP (default 1mb)
# REQUEST_BODY_LIMIT=1mb

# Retencion de datos (desactivado por defecto)
# DATA_RETENTION_ENABLED=true
# RETENTION_JOB_HISTORY_MAX=100
